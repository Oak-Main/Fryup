---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import FryUpTimer from '../components/tools/FryUpTimer';
---

<BaseLayout title="Synchronized Fry-Up Multi-Timer — Fryup.UK" description="Coordinated multi-dish breakfast timer so your bacon, sausages, eggs, black pudding, and hash browns finish hot at the exact same moment.">
  <Breadcrumbs items={[{ label: 'Fry-Up Timer' }]} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <span class="text-xs uppercase font-semibold text-amber-700 tracking-wider">Multi-Item Cooking Timer</span>
      <h1 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 mt-1">Synchronized Fry-Up Multi-Timer</h1>
      <p class="text-stone-600 mt-2 max-w-2xl">
        Run five timers at once so your sausages, hash browns, black pudding, back bacon and fried
        eggs all reach the plate together. Every timer has its own controls, and you can adjust a
        cooking time to suit your pan and your hob.
      </p>
    </div>

    <FryUpTimer client:load />
  </div>
</BaseLayout>
